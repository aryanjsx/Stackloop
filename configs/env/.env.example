# StackLoop environment configuration
#
# Copy this file to a .env at the repository root and fill in real values:
#   cp configs/env/.env.example .env
#
# Never commit a filled-in .env. Every variable below is read by the application;
# if you add a new one, add it here too and document it in the README.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3001

# Public origin of the web app. Used for CORS and as the default post-login redirect.
WEB_APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://stackloop:stackloop@localhost:5432/stackloop

# ---------------------------------------------------------------------------
# GitHub OAuth
# ---------------------------------------------------------------------------
# Create an OAuth app at https://github.com/settings/developers.
# The callback URL registered with GitHub must match GITHUB_REDIRECT_URI exactly.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# ---------------------------------------------------------------------------
# GitHub REST API (repository ingestion)
# ---------------------------------------------------------------------------
# A personal access token with public_repo scope. Raises the rate limit from
# 60 to 5000 requests/hour.

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Tokens and sessions
# ---------------------------------------------------------------------------
# JWT_SIGNING_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The application refuses to start in production if this is unset or left at a
# development placeholder. See docs/adr/0001-jwt-signing-algorithm.md.

JWT_SIGNING_SECRET=
JWT_ISSUER=stackloop
JWT_AUDIENCE=stackloop-api

# Access token lifetime in seconds (default 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds (default 30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000

# How long an in-flight OAuth login may remain unfinished, in seconds.
OAUTH_STATE_TTL_SECONDS=600
